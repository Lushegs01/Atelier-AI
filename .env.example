# Copy to .env.local. Empty external credentials intentionally disable integrations.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Explicit development-only demonstration label; never a payment/AI fallback.
NEXT_PUBLIC_DEMO_MODE=false
# Default: free public Hugging Face ZeroGPU Spaces (photo, try-on, 5 s video). No GPU of your own.
# Alternatives: qwen (your own GPU service) or fashn (paid). Never an automatic fallback.
AI_PROVIDER=huggingface
# Server-only, READ-ONLY token from https://huggingface.co/settings/tokens. Never use NEXT_PUBLIC_.
# Free accounts share one daily ZeroGPU quota across every tenant of this deployment.
HF_TOKEN=
# Optional: duplicates of the default Spaces with the same API, e.g. your-name/Leffa.
# Defaults: multimodalart/Qwen-Image-Edit-Fast, franciszzj/Leffa, zerogpu-aoti/wan2-2-fp8da-aoti-faster
HF_PHOTO_SPACE=
HF_TRY_ON_SPACE=
HF_VIDEO_SPACE=
# Seconds a worker holds a Space result stream (30-280, default 240). Must fit the host's function
# limit (the Inngest route declares 300 s). Closing the stream early cancels the Space job.
HF_RESULT_WAIT_SECONDS=
# Operator-hosted open-weight image editing (AI_PROVIDER=qwen). Model weights do not include GPU hosting.
# Private HTTPS inference endpoint; provision with inference/qwen/README.md.
QWEN_API_URL=
# Random shared service token (32+ characters), not a paid vendor API account key.
QWEN_API_KEY=
# Explicit local development exception only; production always requires HTTPS.
QWEN_ALLOW_INSECURE_LOCAL=false
# Optional paid alternative: AI_PROVIDER=fashn. No automatic provider fallback.
FASHN_API_KEY=
# Every capability is Experimental; enable each separately after acceptance and price review.
ENABLE_PHOTO_GENERATION=false
ENABLE_TRY_ON=false
# Hugging Face (Wan 2.2) or FASHN only; Qwen has no video capability even if this is true.
ENABLE_VIDEO_GENERATION=false
FASHN_OUTPUT_HOSTS=cdn.fashn.ai
MAX_UPLOAD_BYTES=4194304
MAX_IMAGE_PIXELS=40000000
STORAGE_BUCKET=private-media
CUSTOMER_PHOTO_RETENTION_HOURS=24
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
ALLOW_LIVE_PAYMENTS=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set 1 only while running the local Inngest dev server.
INNGEST_DEV=0
SENTRY_DSN=
CRON_SECRET=
SUPPORT_EMAIL=
