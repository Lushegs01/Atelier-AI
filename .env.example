# Copy to .env.local. Empty external credentials intentionally disable integrations.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Explicit development-only demonstration label; never a payment/AI fallback.
NEXT_PUBLIC_DEMO_MODE=false
# AI provider: huggingface (free ZeroGPU Spaces, the default) or fashn (paid API).
AI_PROVIDER=huggingface
# Free "read" token from https://huggingface.co/settings/tokens; it carries your daily GPU quota.
HF_TOKEN=
# Optional: your own duplicates of the default Spaces (same API), e.g. your-name/Leffa.
HF_PHOTO_SPACE=
HF_TRY_ON_SPACE=
HF_VIDEO_SPACE=
# Only used when AI_PROVIDER=fashn.
FASHN_API_KEY=
# Enable each operation individually after staging acceptance.
ENABLE_PHOTO_GENERATION=false
ENABLE_TRY_ON=false
ENABLE_VIDEO_GENERATION=false
FASHN_OUTPUT_HOSTS=cdn.fashn.ai
MAX_UPLOAD_BYTES=4194304
MAX_IMAGE_PIXELS=40000000
STORAGE_BUCKET=private-media
CUSTOMER_PHOTO_RETENTION_HOURS=24
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
ALLOW_LIVE_PAYMENTS=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set 1 only while running the local Inngest dev server.
INNGEST_DEV=0
SENTRY_DSN=
CRON_SECRET=
SUPPORT_EMAIL=
