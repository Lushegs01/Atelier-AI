# Copy to .env.local. Empty external credentials intentionally disable integrations.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Explicit development-only demonstration label; never a payment/AI fallback.
NEXT_PUBLIC_DEMO_MODE=false
# Default: operator-hosted open-weight image editing. Model weights do not include GPU hosting.
AI_PROVIDER=qwen
# Private HTTPS inference endpoint; provision with inference/qwen/README.md.
QWEN_API_URL=
# Random shared service token (32+ characters), not a paid vendor API account key.
QWEN_API_KEY=
# Explicit local development exception only; production always requires HTTPS.
QWEN_ALLOW_INSECURE_LOCAL=false
# Free alternative: AI_PROVIDER=huggingface with a free read token from
# https://huggingface.co/settings/tokens (daily ZeroGPU quota; photos, try-on and 5 s 480p video).
HF_TOKEN=
# Optional: private duplicates of the default Spaces (same API), e.g. your-name/Leffa.
HF_PHOTO_SPACE=
HF_TRY_ON_SPACE=
HF_VIDEO_SPACE=
# Optional paid alternative: AI_PROVIDER=fashn. No automatic provider fallback.
FASHN_API_KEY=
# Qwen photo and customer image-edit visualization are Experimental; enable separately after acceptance.
ENABLE_PHOTO_GENERATION=false
ENABLE_TRY_ON=false
# Qwen has no video capability, even if this flag is true. FASHN-only optional capability.
ENABLE_VIDEO_GENERATION=false
FASHN_OUTPUT_HOSTS=cdn.fashn.ai
MAX_UPLOAD_BYTES=4194304
MAX_IMAGE_PIXELS=40000000
STORAGE_BUCKET=private-media
CUSTOMER_PHOTO_RETENTION_HOURS=24
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
ALLOW_LIVE_PAYMENTS=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set 1 only while running the local Inngest dev server.
INNGEST_DEV=0
SENTRY_DSN=
CRON_SECRET=
SUPPORT_EMAIL=
