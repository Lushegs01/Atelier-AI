# Shared with the Next.js QWEN_API_KEY; generate a random 32+ character value privately.
QWEN_API_KEY=
# Must exactly match Next.js QWEN_API_URL, including an optional reverse-proxy prefix.
QWEN_PUBLIC_URL=https://YOUR-PRIVATE-GPU-HOST
NODE_ENV=production
QWEN_ALLOW_INSECURE_LOCAL=false
QWEN_DATA_DIR=/data/qwen
HF_HOME=/cache/huggingface
QWEN_RETENTION_HOURS=24
QWEN_MAX_QUEUE=20
QWEN_OFFLOAD=model
QWEN_MODEL_REVISION=6f3ccc0b56e431dc6a0c2b2039706d7d26f22cb9
